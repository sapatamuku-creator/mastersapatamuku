{
  "name": "mastersapatamuku",
  "version": "1.0.0",
  "scripts": {
    "build": "echo 'No build step required'",
    "build:css": "tailwindcss -i ./assets/tailwind.input.css -o ./assets/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./assets/tailwind.input.css -o ./assets/tailwind.css --watch"
  },
  "dependencies": {
    "@vercel/og": "^0.6.5",
    "pdf-parse": "^2.4.5",
    "pdf.js-extract": "^1.0.1",
    "playwright": "^1.60.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "antigravity.ide.project": {
    "engine": "RTX-Accelerated-Agent",
    "plugins": [
      {
        "name": "emilkowalski/skill",
        "purpose": "Cloud & Local Gallery UI Fluidity with Responsive Masonry/Justified",
        "version": "latest",
        "config": {
          "strictJustifiedLayout": true,
          "gpuAcceleratedCSS": true
        }
      },
      {
        "name": "addyosmani/agent-skills",
        "purpose": "Local OS File System Access, Sub-folder Exporter, Regex Index Parser",
        "version": "latest",
        "config": {
          "allowNativeFileDescriptorBridging": true,
          "lowLatencyFileWatcher": true,
          "fileSystemWritePermissions": true
        }
      }
    ]
  },
  "devDependencies": {
    "@omniroute/opencode-plugin": "^0.2.0",
    "tailwindcss": "^3.4.1"
  }
}
