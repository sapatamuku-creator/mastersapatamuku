{
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/u/:id/:u",
      "destination": "/api/undangan?id=:id&u=:u"
    },
    {
      "source": "/u/:id",
      "destination": "/api/undangan?id=:id"
    },
    {
      "source": "/((?!api|assets|releases|node_modules|.*\\.html|.*\\.js|.*\\.css|.*\\.png|.*\\.jpg|.*\\.ico|.*\\.txt|login|register|dashboard|owner)[^/]+)",
      "destination": "/index.html"
    }
  ]
}
