{
  "theme_id": "standard_clean_minimalis_1",
  "theme_name": "Standard Clean Minimalist 1",
  "description": "Desain elegan, minimalis, dan bersih dengan dominasi warna putih dan emas.",
  "schema": [
    {
      "section": "global",
      "label": "Konfigurasi Utama",
      "fields": [
        { "key": "headerLabel", "label": "Label Header", "type": "text", "default": "The Wedding Celebration" },
        { "key": "hashtag", "label": "Hashtag", "type": "text", "default": "#SatuBINTANGuntukANISA" },
        { "key": "coverBg", "label": "Background Cover", "type": "image" },
        { "key": "heroImg", "label": "Foto Hero (Utama)", "type": "image" },
        { "key": "weddingDate", "label": "Tanggal Acara (Cover)", "type": "text", "default": "Senin, 25 Mei 2026" },
        { "key": "greeting", "label": "Teks Sapaan", "type": "text", "default": "Yth. Bapak/Ibu/Saudara/i" },
        { "key": "musicUrl", "label": "Tautan Musik (MP3)", "type": "audio" }
      ]
    },
    {
      "section": "groom",
      "label": "Mempelai Pria",
      "toggle": "show_groom",
      "fields": [
        { "key": "groom.header", "label": "Judul Section", "type": "text", "default": "the Groom" },
        { "key": "groom.name", "label": "Nama Lengkap Pria", "type": "text", "default": "Bintang Zahlahar Trijati" },
        { "key": "groom.desc", "label": "Silsilah Pria", "type": "textarea", "default": "Putra ke-4 dari Bp. Nana Herna Sutisna & Almh. Ibu Eva Refliana" },
        { "key": "groom.photo", "label": "Foto Pria", "type": "image" },
        { "key": "groom.ig", "label": "Username Instagram Pria", "type": "text", "default": "@bintangzt" }
      ]
    },
    {
      "section": "bride",
      "label": "Mempelai Wanita",
      "toggle": "show_bride",
      "fields": [
        { "key": "bride.header", "label": "Judul Section", "type": "text", "default": "the Bride" },
        { "key": "bride.name", "label": "Nama Lengkap Wanita", "type": "text", "default": "Anisa Nur Fitria" },
        { "key": "bride.desc", "label": "Silsilah Wanita", "type": "textarea", "default": "Putri ke-1 dari Bp. Udin Jaenudin & Ibu Susi Yamayanti" },
        { "key": "bride.photo", "label": "Foto Wanita", "type": "image" },
        { "key": "bride.ig", "label": "Username Instagram Wanita", "type": "text", "default": "@anisanrf" }
      ]
    },
    {
      "section": "events",
      "label": "Acara (Events)",
      "toggle": "show_events",
      "fields": [
        { "key": "events_header", "label": "Judul Section Acara", "type": "text", "default": "Wedding Events" },
        { "key": "ev1.name", "label": "Nama Acara 1", "type": "text", "default": "Akad Nikah" },
        { "key": "ev1.date", "label": "Tanggal Acara 1 (DD/MM/YYYY)", "type": "date", "default": "25/05/2026" },
        { "key": "ev1.time", "label": "Waktu Acara 1 (08:00)", "type": "time", "default": "08:00" },
        { "key": "ev1.locName", "label": "Alamat Acara 1", "type": "textarea" },
        { "key": "ev1.photo", "label": "Foto/Ilustrasi Acara 1", "type": "image" },
        { "key": "ev1.maps", "label": "Link Google Maps 1", "type": "url" },
        { "key": "ev2.name", "label": "Nama Acara 2", "type": "text", "default": "Resepsi" },
        { "key": "ev2.date", "label": "Tanggal Acara 2 (DD/MM/YYYY)", "type": "date", "default": "25/05/2026" },
        { "key": "ev2.time", "label": "Waktu Acara 2 (11:00)", "type": "time", "default": "11:00" },
        { "key": "ev2.locName", "label": "Alamat Acara 2", "type": "textarea" },
        { "key": "ev2.photo", "label": "Foto/Ilustrasi Acara 2", "type": "image" },
        { "key": "ev2.maps", "label": "Link Google Maps 2", "type": "url" }
      ]
    },
    {
      "section": "gifts",
      "label": "Tanda Kasih (Gifts)",
      "toggle": "show_gift",
      "fields": [
        { "key": "gift_header", "label": "Judul Section Hadiah", "type": "text", "default": "Wedding Gift" },
        { "key": "gifts[0].acc", "label": "No. Rekening/Dana 1", "type": "text" },
        { "key": "gifts[0].owner", "label": "Atas Nama Rekening 1", "type": "text" },
        { "key": "gifts[1].acc", "label": "No. Rekening/Dana 2", "type": "text" },
        { "key": "gifts[1].owner", "label": "Atas Nama Rekening 2", "type": "text" },
        { "key": "gifts[2].acc", "label": "No. Rekening/Dana 3", "type": "text" },
        { "key": "gifts[2].owner", "label": "Atas Nama Rekening 3", "type": "text" }
      ]
    },
    {
      "section": "gallery",
      "label": "Galeri Foto",
      "toggle": "show_gallery",
      "fields": [
        { "key": "gallery_header", "label": "Judul Section Galeri", "type": "text", "default": "Our Gallery" },
        { "key": "gallery", "label": "Foto-foto Galeri", "type": "image_array", "max": 6 }
      ]
    },
    {
      "section": "wishes",
      "label": "Ucapan & Doa",
      "toggle": "show_wishes",
      "fields": [
        { "key": "wishes_header", "label": "Judul Section Ucapan", "type": "text", "default": "Wishes & Prayers" }
      ]
    }
  ]
}
